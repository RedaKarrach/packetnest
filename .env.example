# Copy to .env and change the values marked "change-me".

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when the site is reached through a domain over https, e.g. https://packetnest.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL (POSTGRES_HOST/PORT are forced to db:5432 inside docker compose)
POSTGRES_DB=packetnest
POSTGRES_USER=packetnest
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Capture storage: leave CAPTURES_BUCKET empty to store files in the media volume.
CAPTURES_BUCKET=
AWS_REGION=eu-west-3

# Local development / tests without PostgreSQL
USE_SQLITE=0

# Optional: password for the demo accounts created by `manage.py seed_demo`
SEED_PASSWORD=
